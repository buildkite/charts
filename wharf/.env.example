# Fleet default computer for every new bot: docker | box | mac
WHARF_COMPUTER_PROVIDER=docker
WHARF_PORT=8787
WHARF_DATA_DIR=./data
WHARF_HOST=127.0.0.1

# OpenAI-compatible models (OpenRouter, OpenAI, Ollama, LM Studio)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini

# Local models: point at Ollama instead
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2

# Box remote Ubuntu VMs (https://box.ascii.dev) — optional per-bot override
BOX_TOKEN=
BOX_API=https://ascii.dev/api/box/v1

# Mac companion (Electron CUA bridge). Only used when a bot is set to mac.
WHARF_MAC_BRIDGE_URL=

# Docker computer image / idle pause
WHARF_DOCKER_IMAGE=wharf/computer:local
WHARF_IDLE_MS=600000

# First-run gate for a public host (comma-separated emails). Empty = open local.
WHARF_SIGNUP_ALLOWLIST=
WHARF_AUTH_TOKEN=
