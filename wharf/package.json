{
  "name": "wharf",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted crew of AI bots. Docker computers by default; Box VMs or this Mac as options.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --experimental-sqlite --import tsx src/index.ts",
    "test": "node --experimental-sqlite --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
